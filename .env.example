# Copy to .env and provide credentials/model IDs supported by your account.
OPENAI_API_KEY=
RESUME_PARSER_MODEL=

# Required: generate a random secret of at least 32 characters.
ATS_API_KEY=

# Optional: only set for a model that supports this parameter.
REASONING_EFFORT=

# Relative paths resolve beside db.py, independently of the launch directory.
DATABASE_PATH=sessions.db

# Tracing may include resume text and contact details. Disabled by default.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
